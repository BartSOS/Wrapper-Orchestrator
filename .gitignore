# ==============================================================================
# TopCom Battle Orchestrator - .gitignore
# ==============================================================================

# Diretório de build e artefatos compilados
build/
bin/
*.o
*.out
*.exe
*.class

# Jar gerados (preservando bibliotecas canônicas em libs/)
*.jar
!libs/*.jar

# Caches de interpretadores e linguagens
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/

# Replays e logs gerados pelas partidas
replays/
match_frames.json
resultado_partida.json

# Submissões dinâmicas (alimentadas em runtime pelo BOCA ou testes)
submissoes/*
!submissoes/.gitkeep

# Arquivos temporários e de editores/SO
.DS_Store
Thumbs.db
*.swp
*.swo
*~
.vscode/
.idea/

