# Finais de linha: LF no repositório e no checkout, em qualquer máquina.
# Os .sh e .py rodam em Linux (WSL e contêineres); CRLF quebra o bash.
* text=auto eol=lf

# Scripts do Windows precisam de CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Arquivo só para leitura humana: nunca convertido (CLAUDE.md §6)
credenciais.txt -text

# Binários
*.zip binary
*.tgz binary
*.gz binary
*.jar binary
*.class binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.docx binary
*.xlsx binary
*.dump binary
*.exe binary
*.dll binary
*.so binary
*.o binary
*.gch binary
